---
// Image gallery matching the blog-post gallery: one main stage image plus a
// clickable thumbnail strip, auto-advance with a progress ring, and a
// click-to-zoom lightbox. Only the current full image is loaded at a time
// (thumbnails are tiny WebPs), so the page stays light. One instance per page.
interface Props {
  images: { src: string; caption: string }[];
  interval?: number;
  ratio?: string;
  label?: string;
}
const { images, interval = 4500, ratio = '4 / 5', label = 'Photo gallery' } = Astro.props;
// Tiny WebP thumbnail next to each full image, in a sibling thumbs/ folder:
// /media/<dir>/x.jpg -> /media/<dir>/thumbs/x.webp
const thumbOf = (src: string) =>
  src.replace(/\/([^/]+)\.jpe?g$/i, '/thumbs/$1.webp');
---
<figure
  class="ag"
  style={`--ag-ratio: ${ratio}; --ag-int: ${interval}ms;`}
  data-interval={interval}
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="ag-stage hud-card">
    <button class="ag-zoom" type="button" aria-label="View image full size">
      <img
        class="ag-main"
        src={images[0].src}
        alt={images[0].caption}
        decoding="async"
        fetchpriority="low"
      />
    </button>
    <button class="ag-arrow ag-prev" type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
    </button>
    <button class="ag-arrow ag-next" type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <span class="ag-count mono" aria-hidden="true"><span class="ag-cur">1</span> / {images.length}</span>
  </div>
  <p class="ag-cap" aria-live="polite">{images[0].caption}</p>
  <div class="ag-foot">
    <button class="ag-toggle" type="button" aria-label="Pause slideshow" aria-pressed="true">
      <svg class="ag-ring" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" pathLength="100"/></svg>
      <svg class="ag-ico ag-ico-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1"/><rect x="9.5" y="2" width="3.5" height="12" rx="1"/></svg>
      <svg class="ag-ico ag-ico-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z"/></svg>
    </button>
    <div class="ag-thumbs" role="tablist" aria-label="Choose image">
      {images.map((im, i) => (
        <button
          class:list={['ag-thumb', { 'is-active': i === 0 }]}
          type="button"
          role="tab"
          data-i={i}
          data-full={im.src}
          data-cap={im.caption}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`View image ${i + 1}`}
        >
          <img src={thumbOf(im.src)} alt="" loading="lazy" decoding="async" width="120" height="90" />
        </button>
      ))}
    </div>
  </div>
</figure>

<!-- Shared lightbox (one per page) -->
<div class="ag-lightbox" hidden>
  <button class="lb-close" type="button" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous">‹</button>
  <figure class="lb-figure">
    <img class="lb-img" src={images[0].src} alt="" />
    <figcaption class="lb-cap"></figcaption>
  </figure>
  <button class="lb-nav lb-next" type="button" aria-label="Next">›</button>
</div>

<style>
  .ag { margin: 0; }
  .ag-stage {
    position: relative;
    aspect-ratio: var(--ag-ratio);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(126, 168, 255, 0.08), transparent 60%),
      var(--bg-0);
  }
  .ag-zoom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    display: block;
  }
  .ag-main {
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin: 0;
    border: 0;
    border-radius: 0;
    opacity: 1;
    transition: opacity 0.35s ease;
  }
  .ag.is-swapping .ag-main { opacity: 0; }

  .ag-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    color: #fff;
    cursor: pointer;
    opacity: 0.78;
    transition: opacity 0.15s ease, border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .ag-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ag-arrow[hidden] { display: none; }
  .ag-arrow:hover { opacity: 1; background: rgba(0, 0, 0, 0.7); border-color: var(--accent); color: var(--accent); }
  .ag-arrow:focus-visible { opacity: 1; outline: 2px solid var(--accent); outline-offset: 2px; }
  .ag-prev { left: 0.6rem; }
  .ag-next { right: 0.6rem; }
  @media (max-width: 560px) {
    .ag-arrow { width: 34px; height: 34px; }
    .ag-arrow svg { width: 15px; height: 15px; }
    .ag-prev { left: 0.45rem; }
    .ag-next { right: 0.45rem; }
  }

  .ag-count {
    position: absolute;
    bottom: 0.7rem;
    left: 0.8rem;
    font-size: 0.72rem;
    color: var(--text-1);
    letter-spacing: 0.08em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    pointer-events: none;
  }
  .ag-cap {
    min-height: 2.6em;
    margin: 0.7rem 0 0.6rem;
    color: var(--text-1);
    font-size: 0.88rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .ag-foot { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
  .ag-thumbs {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.3rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .ag-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-0);
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  .ag-thumb img { width: 100%; height: 100%; object-fit: cover; margin: 0; border: 0; border-radius: 0; }
  .ag-thumb:hover, .ag-thumb.is-active { opacity: 1; border-color: var(--accent); }

  .ag-toggle {
    position: relative;
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg-0);
    color: var(--text-1);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .ag-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .ag-ico { width: 13px; height: 13px; fill: currentColor; }
  .ag:not(.is-playing) .ag-ico-pause { display: none; }
  .ag.is-playing .ag-ico-play { display: none; }
  .ag-ring { position: absolute; inset: -1px; transform: rotate(-90deg); pointer-events: none; }
  .ag-ring circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .ag.is-playing .ag-ring circle { animation: ag-ring var(--ag-int) linear infinite; }
  .ag.is-paused .ag-ring circle { animation-play-state: paused; }
  @keyframes ag-ring { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  /* Lightbox */
  .ag-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--overlay-bg);
    padding: 2rem 3.5rem;
  }
  .ag-lightbox[hidden] { display: none; }
  .lb-figure { margin: 0; max-width: 100%; max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  .lb-img { max-width: 100%; max-height: 82vh; width: auto; border-radius: var(--radius); border: 1px solid var(--line-strong); }
  .lb-cap { color: var(--text-1); font-size: 0.9rem; text-align: center; max-width: 60ch; }
  .lb-close, .lb-nav {
    position: absolute;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    color: var(--text-0);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .lb-close:hover, .lb-nav:hover { border-color: var(--accent); color: var(--accent); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 0.6rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 0.6rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 560px) {
    .ag-lightbox { padding: 1rem; }
    .lb-prev { left: 0.4rem; }
    .lb-next { right: 0.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-main { transition: none; }
    .ag.is-playing .ag-ring circle { animation: none; }
  }
</style>

<script>
  function initAutoGalleries() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.ag').forEach((root) => {
      if ((root as any).__agInit) return;
      (root as any).__agInit = true;

      const main = root.querySelector<HTMLImageElement>('.ag-main')!;
      const cap = root.querySelector<HTMLElement>('.ag-cap')!;
      const curEl = root.querySelector<HTMLElement>('.ag-cur')!;
      const toggle = root.querySelector<HTMLButtonElement>('.ag-toggle')!;
      const strip = root.querySelector<HTMLElement>('.ag-thumbs')!;
      const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ag-thumb'));
      const items = thumbs.map((t) => ({ src: t.dataset.full || '', cap: t.dataset.cap || '' }));
      if (!items.length) return;

      // Lightbox is the gallery's next sibling.
      const lb = root.nextElementSibling as HTMLElement;
      const lbImg = lb?.querySelector<HTMLImageElement>('.lb-img');
      const lbCap = lb?.querySelector<HTMLElement>('.lb-cap');

      let cur = 0;
      let playing = false;
      const ring = root.querySelector<SVGCircleElement>('.ag-ring circle');

      // Stage arrows step the gallery but, unlike the auto-loop, do not wrap:
      // the prev arrow hides on the first image and next hides on the last.
      const prevBtn = root.querySelector<HTMLButtonElement>('.ag-prev');
      const nextBtn = root.querySelector<HTMLButtonElement>('.ag-next');
      const updateArrows = () => {
        if (prevBtn) prevBtn.hidden = cur === 0;
        if (nextBtn) nextBtn.hidden = cur === items.length - 1;
      };

      // Preload a full image so the swap is instant when we reach it.
      const preload = (i: number) => {
        const im = new Image();
        im.src = items[((i % items.length) + items.length) % items.length].src;
      };

      const centerThumb = () => {
        const t = thumbs[cur];
        const s = strip.getBoundingClientRect();
        const r = t.getBoundingClientRect();
        strip.scrollBy({ left: r.left + r.width / 2 - (s.left + s.width / 2), behavior: 'smooth' });
      };

      const show = (k: number) => {
        cur = (k + items.length) % items.length;
        root.classList.add('is-swapping');
        const swap = () => {
          main.src = items[cur].src;
          main.alt = items[cur].cap;
          requestAnimationFrame(() => root.classList.remove('is-swapping'));
        };
        if (reduce) swap();
        else window.setTimeout(swap, 110);
        cap.textContent = items[cur].cap;
        curEl.textContent = String(cur + 1);
        thumbs.forEach((t, ti) => {
          const on = ti === cur;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        centerThumb();
        updateArrows();
        preload(cur + 1); // ready the next one ahead of time
      };

      const play = () => {
        if (reduce || items.length < 2) return;
        playing = true;
        root.classList.remove('is-paused');
        // Restart the ring cleanly from 0 so the countdown matches the swaps.
        root.classList.remove('is-playing');
        void root.offsetWidth; // reflow to reset the CSS animation
        root.classList.add('is-playing');
        toggle.setAttribute('aria-pressed', 'true');
        toggle.setAttribute('aria-label', 'Pause slideshow');
      };
      const stop = () => {
        playing = false;
        root.classList.remove('is-playing', 'is-paused');
        toggle.setAttribute('aria-pressed', 'false');
        toggle.setAttribute('aria-label', 'Play slideshow');
      };

      // One clock: advance exactly when the progress ring completes a loop, so
      // the image change can never drift away from the visible countdown.
      ring?.addEventListener('animationiteration', () => {
        if (playing && !document.hidden) show(cur + 1);
      });

      thumbs.forEach((t) => t.addEventListener('click', () => { stop(); show(Number(t.dataset.i)); }));
      toggle.addEventListener('click', () => (playing ? stop() : play()));

      // Stage arrows: pause the auto-loop and step the gallery. They sit above
      // the zoom button, so a click here navigates instead of opening the lightbox.
      if (items.length < 2) { prevBtn?.remove(); nextBtn?.remove(); }
      prevBtn?.addEventListener('click', () => { stop(); show(cur - 1); });
      nextBtn?.addEventListener('click', () => { stop(); show(cur + 1); });
      updateArrows(); // initial state: prev hidden on the first image

      if (lb && lbImg && lbCap) {
        const syncLb = () => { lbImg.src = items[cur].src; lbImg.alt = items[cur].cap; lbCap.textContent = items[cur].cap; };
        const open = () => { syncLb(); lb.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; };
        const close = () => { lb.setAttribute('hidden', ''); document.body.style.overflow = ''; };
        root.querySelector('.ag-zoom')!.addEventListener('click', () => { stop(); open(); });
        lb.querySelector('.lb-close')!.addEventListener('click', close);
        lb.querySelector('.lb-prev')!.addEventListener('click', () => { show(cur - 1); syncLb(); });
        lb.querySelector('.lb-next')!.addEventListener('click', () => { show(cur + 1); syncLb(); });
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        (window as any).__agKey && document.removeEventListener('keydown', (window as any).__agKey);
        const onKey = (e: KeyboardEvent) => {
          if (lb.hasAttribute('hidden')) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowLeft') { show(cur - 1); syncLb(); }
          else if (e.key === 'ArrowRight') { show(cur + 1); syncLb(); }
        };
        (window as any).__agKey = onKey;
        document.addEventListener('keydown', onKey);
      }

      preload(1);
      play();
    });
  }
  import { onPageReady } from '../lib/page-ready';
  onPageReady(initAutoGalleries);
</script>
