---
<ul class:list={["socials", { compact }]}>
  {socials.map(({ label, href, icon }) => (
    <li>
      <a href={href} target="_blank" rel="noopener" aria-label={label} data-tip={label}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d={icon}></path>
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .socials {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .socials li { position: relative; }
  .socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--text-1);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .socials.compact { gap: 0.55rem; }
  .socials.compact a { width: 36px; height: 36px; }
  .socials.compact svg { width: 17px; height: 17px; }
  /* hover/focus tooltip with the site name */
  .socials a::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    top: calc(100% + 8px);
    transform: translateX(-50%) translateY(-4px);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg-1, var(--bg-0));
    color: var(--text-0);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 5;
  }
  .socials a:hover::after,
  .socials a:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
</style>
