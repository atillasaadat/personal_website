---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  cover?: string;
  tags?: string[];
  highlight?: string;
  highlightHref?: string;
}

const { href, title, description, date, cover, tags = [], highlight, highlightHref } = Astro.props;
const dateFmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const isVideo = cover?.endsWith('.mp4');
const poster = isVideo ? cover!.replace(/\.mp4$/, '-poster.jpg') : undefined;
---
<article class="card hud-card">
  {/* Stretched link makes the whole card open the post, while leaving the
      highlight link below clickable in its own right (no nested anchors). */}
  <a class="card-link" href={href} aria-label={title}></a>
  {cover && (
    <div class="cover">
      {isVideo ? (
        <video muted loop playsinline preload="none" poster={poster} width="640" height="360" data-card-video>
          <source src={cover} type="video/mp4" />
        </video>
      ) : (
        <img src={cover} alt="" loading="lazy" decoding="async" width="640" height="360" />
      )}
    </div>
  )}
  <div class="body">
    <p class="meta">
      <time datetime={date.toISOString().slice(0, 10)}>{dateFmt}</time>
      {tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
    </p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    {highlight && (highlightHref
      ? <a class="highlight highlight-link" href={highlightHref} target="_blank" rel="noopener">★ {highlight} ↗</a>
      : <p class="highlight">★ {highlight}</p>
    )}
    <span class="more" aria-hidden="true">Read more →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    height: 100%;
  }
  .card:hover { transform: translateY(-3px); }
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .cover img, .cover video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.4s ease;
  }
  .card:hover .cover img, .card:hover .cover video { transform: scale(1.04); }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.25rem 1.3rem;
    flex: 1;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .tag { color: var(--accent-2); }
  h3 { margin: 0; font-size: 1.08rem; }
  .desc {
    margin: 0;
    color: var(--text-1);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .highlight {
    margin: 0;
    color: var(--warn);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  /* a highlight that is a link sits above the stretched card link */
  a.highlight-link {
    position: relative;
    z-index: 2;
    width: fit-content;
    text-decoration: none;
  }
  a.highlight-link:hover { text-decoration: underline; text-underline-offset: 2px; }
  .more {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>

<script>
  // Only play a card's video cover while it is on screen (and only load it
  // then, since preload="none"). Avoids decoding several videos at once on the
  // projects grid. Re-armed on every page view for client-side navigation.
  function setupCardVideos() {
    const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-card-video]'));
    (window as any).__cardVidIO?.disconnect?.();
    if (!vids.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; // posters only
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: '150px 0px' },
    );
    vids.forEach((v) => io.observe(v));
    (window as any).__cardVidIO = io;
  }
  document.addEventListener('astro:page-load', setupCardVideos);
</script>
