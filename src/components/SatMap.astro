---
// Live 3D on-orbit asset tracker, the satellites Atilla has contributed to.
// Rendered by a self-contained CesiumJS globe at /satmap.html (live TLEs from
// Celestrak with an embedded fallback snapshot).
//
// Performance: the globe is NOT loaded on initial page render. It auto-loads
// the moment the section scrolls near the viewport (IntersectionObserver), so
// the top of the page stays fast but the visitor never has to click anything.
const satCount = 20;
---
<section id="satmap" class="section">
  <div class="container">
    <div class="section-head">
      <p class="kicker">// ON ORBIT</p>
      <h2>Live 3D Orbits of {satCount} Satellites I've Contributed To</h2>
    </div>
    <div class="map-shell hud-card" id="satmap-shell">
      <div id="satmap-loading" class="loading">
        <span class="spinner" aria-hidden="true"></span>
        <span class="loading-text">Acquiring orbital data…</span>
      </div>
      <noscript>
        <iframe
          src="/satmap.html"
          title="Live 3D satellite tracker"
          style="position:absolute;inset:0;width:100%;height:100%;border:0;"
        ></iframe>
      </noscript>
    </div>
    <p class="ext">
      <button type="button" id="satmap-fs" class="linkish" hidden>Fullscreen ⛶</button>
      <a href="/satmap.html" target="_blank" rel="noopener">Open the tracker in a new tab ↗</a>
    </p>
  </div>
</section>

<style>
  .map-shell {
    position: relative;
    height: clamp(440px, 80vh, 920px);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(34, 60, 110, 0.35), transparent 60%),
      var(--bg-1);
  }
  .loading[hidden] { display: none !important; }
  .loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
    z-index: 2;
  }
  .spinner {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 3px solid rgba(94, 234, 212, 0.2);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
  }
  .loading-text {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-1);
    letter-spacing: 0.05em;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* fullscreen: let the globe fill the whole viewport */
  .map-shell:fullscreen { height: 100%; width: 100%; border-radius: 0; }

  .ext {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .linkish:hover { text-decoration: underline; }
</style>

<script>
  const ORIGINS = [
    'https://cesium.com',
    'https://cdnjs.cloudflare.com',
    'https://celestrak.org',
    'https://services.arcgisonline.com',
  ];

  // The heavy subresources the globe iframe pulls. Prefetching them into the
  // HTTP cache while the browser is idle means that by the time the iframe
  // mounts, Cesium + satellite.js load from cache instead of over the network,
  // which is the bulk of the perceived load time. (Cache is partitioned by the
  // top-level site, so the iframe reuses these same-site prefetches.)
  const CESIUM = 'https://cesium.com/downloads/cesiumjs/releases/1.81/Build/Cesium/';
  // Cesium's terrain web worker bootstraps by importScripts-ing these files
  // strictly one after another, each a full round-trip to cesium.com, which
  // was the bulk of the globe's 1-2 s "blank" time. Captured from a request
  // trace of Cesium 1.81; the hashed names must be refreshed if the pinned
  // Cesium version in public/satmap.html ever changes.
  const CESIUM_WORKERS = [
    'cesiumWorkerBootstrapper.js', 'transferTypedArrayTest.js',
    'createVerticesFromHeightmap.js', 'Cartesian2-8417ca3d.js', 'Check-d18af7c4.js',
    'when-208fe5b0.js', 'Math-4e53b694.js', 'EllipsoidTangentPlane-9123a53b.js',
    'Transforms-a73b3b3b.js', 'RuntimeError-7f634f5d.js', 'IntersectionTests-7d224a2f.js',
    'Plane-4aa8974d.js', 'TerrainEncoding-73cbc4e6.js', 'AttributeCompression-f02ec82f.js',
    'ComponentDatatype-9204e9f6.js', 'WebGLConstants-76bb35d1.js',
    'OrientedBoundingBox-18b4901f.js', 'WebMercatorProjection-ffb6b9f8.js',
    'createTaskProcessorWorker.js',
  ].map((f) => CESIUM + 'Workers/' + f);
  // Data tables Cesium needs before the first frame, and the starfield /
  // moon textures so the sky is complete the moment the globe appears.
  const CESIUM_ASSETS = [
    'Assets/approximateTerrainHeights.json',
    'Assets/IAU2006_XYS/IAU2006_XYS_18.json',
    'Assets/Textures/moonSmall.jpg',
    ...['px', 'mx', 'py', 'my', 'pz', 'mz'].map((f) => `Assets/Textures/SkyBox/tycho2t3_80_${f}.jpg`),
  ].map((f) => CESIUM + f);
  const PREFETCH = [
    '/satmap.html',
    '/media/satmap/earth-base.jpg',
    CESIUM + 'Cesium.js',
    CESIUM + 'Widgets/widgets.css',
    'https://cdnjs.cloudflare.com/ajax/libs/satellite.js/4.0.0/satellite.min.js',
    ...CESIUM_WORKERS,
    ...CESIUM_ASSETS,
  ];

  // Inject a <link> once, deduping by rel+href so repeated page-loads (via
  // ClientRouter) never pile up duplicates in <head>.
  function addLink(rel: string, href: string, crossOrigin = false) {
    if (document.head.querySelector('link[rel="' + rel + '"][href="' + href + '"]')) return;
    const l = document.createElement('link');
    l.rel = rel;
    l.href = href;
    if (crossOrigin) l.crossOrigin = '';
    document.head.appendChild(l);
  }

  // Re-init on every page view so the globe still lazy-loads when this section
  // arrives via a client-side navigation (ClientRouter), not just a full load.
  function initSatMap() {
    const shell = document.getElementById('satmap-shell');
    const loading = document.getElementById('satmap-loading');
    const fsBtn = document.getElementById('satmap-fs') as HTMLButtonElement | null;
    if (!shell || !loading || !fsBtn) return;

    // Warm the CDN/data-host connections right away (DNS + TLS during the time
    // the visitor is reading the top of the page), then prefetch the heavy
    // globe assets when the main thread goes idle so they never block the
    // homepage's own critical resources.
    for (const origin of ORIGINS) addLink('preconnect', origin, true);
    // ~5 MB of globe assets: only after the page's own load event, only when
    // the main thread is idle, and never on Data Saver / 2g-3g connections
    // (the globe still loads on demand there, just without the head start).
    const conn = (navigator as any).connection;
    const slowNet = !!conn && (conn.saveData || /2g|3g/.test(conn.effectiveType || ''));
    const prefetchAll = () => { for (const href of PREFETCH) addLink('prefetch', href); };
    const prefetchWhenIdle = () => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(prefetchAll, { timeout: 4000 });
      } else {
        setTimeout(prefetchAll, 1500);
      }
    };
    if (!slowNet) {
      if (document.readyState === 'complete') prefetchWhenIdle();
      else window.addEventListener('load', prefetchWhenIdle, { once: true });
    }

    let loaded = false;
    function loadGlobe() {
      if (loaded) return;
      loaded = true;

      const iframe = document.createElement('iframe');
      iframe.src = '/satmap.html';
      iframe.title = 'Live 3D satellite tracker';
      iframe.allow = 'fullscreen';
      // Styles must be inline: Astro scopes its CSS to template elements, and a
      // JS-created iframe never gets that scope, so a `.map-shell iframe` rule
      // would NOT apply and the iframe would collapse to its default 300x150 box.
      iframe.style.cssText =
        'position:absolute;inset:0;width:100%;height:100%;border:0;z-index:1;';
      // The globe page posts 'satmap-ready' the moment its base imagery is
      // fully rendered (behind its own fade-out veil), so the spinner clears
      // at exactly the right instant. The load-event timer is only a fallback
      // in case the message never arrives.
      const onReady = (e: MessageEvent) => {
        if (e.origin !== location.origin || e.data !== 'satmap-ready') return;
        loading!.hidden = true;
        window.removeEventListener('message', onReady);
      };
      window.addEventListener('message', onReady);
      iframe.addEventListener('load', () => {
        setTimeout(() => { loading!.hidden = true; }, 5000);
      });
      shell!.appendChild(iframe);
      fsBtn!.hidden = false;

      // Cesium redraws every frame for as long as it exists, which drags the
      // whole page's frame rate even when the globe is scrolled out of view.
      // Tell it to stop its render loop while off-screen and resume on return.
      if ('IntersectionObserver' in window) {
        const vis = new IntersectionObserver((entries) => {
          const visible = entries.some((e) => e.isIntersecting);
          iframe.contentWindow?.postMessage(visible ? 'satmap-resume' : 'satmap-pause', location.origin);
        });
        vis.observe(shell!);
      }
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            loadGlobe();
            io.disconnect();
          }
        },
        { rootMargin: '600px' },
      );
      io.observe(shell);
    } else {
      loadGlobe();
    }

    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else shell.requestFullscreen?.();
    });
  }

  import { onPageReady } from '../lib/page-ready';
  onPageReady(initSatMap);
</script>
