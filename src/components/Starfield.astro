---
// Fixed-position animated starfield: drifting + twinkling stars in two parallax
// depth layers, with the occasional shooting star and a slow orbiting satellite
// tracking across the sky. Pure vanilla JS, pauses when the tab is hidden, and
// falls back to a static field for reduced-motion users.
---
<canvas id="starfield" aria-hidden="true" transition:persist="starfield"></canvas>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(56, 89, 153, 0.22), transparent),
      var(--bg-0);
  }
</style>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Star = { x: number; y: number; r: number; v: number; tw: number; tws: number };
  type Shooter = { x: number; y: number; vx: number; vy: number; life: number; len: number };
  type Sat = { x: number; y: number; vx: number; vy: number; blink: number };

  let stars: Star[] = [];
  let shooters: Shooter[] = [];
  let sats: Sat[] = [];
  let w = 0, h = 0, raf = 0, last = 0, nextShoot = 0, nextSat = 0;

  function resize() {
    // Decorative background: render at 1x device pixels. On HiDPI/Retina this
    // cuts the per-frame fill cost by up to 4x with no visible loss on dot-sized
    // stars, which keeps the always-running canvas from dragging frame rate.
    const dpr = 1;
    w = innerWidth; h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.min(170, Math.floor((w * h) / 9500));
    stars = Array.from({ length: count }, () => {
      const depth = Math.random();           // 0 = far/small/slow, 1 = near/big/fast
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.3 + depth * 1.3,
        v: (0.01 + depth * 0.06) * 1.5,
        tw: Math.random() * Math.PI * 2,
        tws: 0.6 + Math.random() * 1.6,       // per-star twinkle speed
      };
    });
  }

  function spawnShooter() {
    const fromLeft = Math.random() < 0.5;
    const speed = 6 + Math.random() * 4;
    const angle = (Math.random() * 0.25 + 0.12) * Math.PI; // shallow downward
    shooters.push({
      x: fromLeft ? -40 : w + 40,
      y: Math.random() * h * 0.5,
      vx: (fromLeft ? 1 : -1) * speed * Math.cos(angle),
      vy: speed * Math.sin(angle),
      life: 1,
      len: 120 + Math.random() * 120,
    });
  }

  function pushSat(x: number, y: number, vx: number, vy: number) {
    sats.push({ x, y, vx, vy, blink: Math.random() * Math.PI * 2 });
  }

  // Pick an angled orbital track: heading, speed, entry point, and the unit
  // vectors along (u) and perpendicular to (p) travel, for placing formations.
  function track() {
    const fromLeft = Math.random() < 0.5;
    const up = Math.random() < 0.5 ? -1 : 1;
    const speed = 0.7 + Math.random() * 0.45;            // far slower than a shooting star
    const angle = 0.2 + Math.random() * 0.32;            // ~11 to 30 deg off horizontal
    const vx = (fromLeft ? 1 : -1) * speed * Math.cos(angle);
    const vy = up * speed * Math.sin(angle);
    const len = Math.hypot(vx, vy);
    return {
      vx, vy,
      ux: vx / len, uy: vy / len,                        // along travel
      px: -vy / len, py: vx / len,                       // perpendicular
      x0: fromLeft ? -24 : w + 24,
      // start in the half of the screen the track climbs/descends away from,
      // so the pass stays on-screen as long as possible
      y0: up < 0 ? h * (0.45 + Math.random() * 0.5) : h * (0.05 + Math.random() * 0.5),
    };
  }

  function spawnSat() {
    const o = track();
    pushSat(o.x0, o.y0, o.vx, o.vy);
  }

  // Formation pass: either a Starlink-style train (5 to 8 in a line along the
  // orbital track) or a tight triangle of 3. Members share one velocity.
  function spawnFormation() {
    const o = track();
    if (Math.random() < 0.7) {
      const n = 5 + Math.floor(Math.random() * 4);       // 5 to 8
      const gap = 22 + Math.random() * 12;
      for (let k = 0; k < n; k++) {
        pushSat(o.x0 - o.ux * gap * k, o.y0 - o.uy * gap * k, o.vx, o.vy);
      }
    } else {
      const s = 26 + Math.random() * 12;                 // triangle scale
      pushSat(o.x0, o.y0, o.vx, o.vy);                   // lead
      pushSat(o.x0 - o.ux * s + o.px * s * 0.6, o.y0 - o.uy * s + o.py * s * 0.6, o.vx, o.vy);
      pushSat(o.x0 - o.ux * s - o.px * s * 0.6, o.y0 - o.uy * s - o.py * s * 0.6, o.vx, o.vy);
    }
  }

  function frame(t: number) {
    const dt = Math.min(2.5, (t - last) / 16.67) || 1; // frames elapsed (caps after tab switch)
    last = t;
    ctx.clearRect(0, 0, w, h);

    // stars
    for (const s of stars) {
      s.y -= s.v * dt;
      if (s.y < -2) { s.y = h + 2; s.x = Math.random() * w; }
      const alpha = 0.3 + 0.5 * Math.abs(Math.sin(t / 1600 * s.tws + s.tw));
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(200, 220, 255, ${alpha})`;
      ctx.fill();
    }

    // shooting stars
    if (t > nextShoot) {
      spawnShooter();
      nextShoot = t + 3000 + Math.random() * 4500; // every 3 to 7.5s (2x the old rate)
    }
    for (let i = shooters.length - 1; i >= 0; i--) {
      const sh = shooters[i];
      sh.x += sh.vx * dt;
      sh.y += sh.vy * dt;
      sh.life -= 0.012 * dt;
      if (sh.life <= 0 || sh.x < -80 || sh.x > w + 80 || sh.y > h + 80) {
        shooters.splice(i, 1);
        continue;
      }
      const tailX = sh.x - sh.vx * (sh.len / 8);
      const tailY = sh.y - sh.vy * (sh.len / 8);
      const grad = ctx.createLinearGradient(sh.x, sh.y, tailX, tailY);
      grad.addColorStop(0, `rgba(180, 230, 255, ${0.9 * sh.life})`);
      grad.addColorStop(1, 'rgba(180, 230, 255, 0)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(sh.x, sh.y);
      ctx.lineTo(tailX, tailY);
      ctx.stroke();
    }

    // orbiting satellites: a steady point of light crossing the sky, with a
    // faint trail, a slow blink, and a tiny glint cross
    if (t > nextSat) {
      if (Math.random() < 0.35) spawnFormation(); else spawnSat();
      nextSat = t + 9000 + Math.random() * 11000; // every 9 to 20s
    }
    for (let i = sats.length - 1; i >= 0; i--) {
      const sat = sats[i];
      sat.x += sat.vx * dt;
      sat.y += sat.vy * dt;
      // wide margin so trailing train members (spawned well off-screen) survive
      if (sat.x < -340 || sat.x > w + 340 || sat.y < -340 || sat.y > h + 340) {
        sats.splice(i, 1);
        continue;
      }
      const pulse = 0.55 + 0.45 * Math.sin(t / 220 + sat.blink);
      // faint trail
      const tx = sat.x - sat.vx * 16;
      const ty = sat.y - sat.vy * 16;
      const grad = ctx.createLinearGradient(sat.x, sat.y, tx, ty);
      grad.addColorStop(0, 'rgba(170, 210, 255, 0.22)');
      grad.addColorStop(1, 'rgba(170, 210, 255, 0)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(sat.x, sat.y);
      ctx.lineTo(tx, ty);
      ctx.stroke();
      // tiny glint cross
      ctx.strokeStyle = `rgba(190, 220, 255, ${0.45 * pulse})`;
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.moveTo(sat.x - 3, sat.y); ctx.lineTo(sat.x + 3, sat.y);
      ctx.moveTo(sat.x, sat.y - 3); ctx.lineTo(sat.x, sat.y + 3);
      ctx.stroke();
      // body
      ctx.beginPath();
      ctx.arc(sat.x, sat.y, 1.4, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(228, 240, 255, ${pulse})`;
      ctx.fill();
    }

    raf = requestAnimationFrame(frame);
  }

  function drawStatic() {
    ctx.clearRect(0, 0, w, h);
    for (const s of stars) {
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(200, 220, 255, 0.55)';
      ctx.fill();
    }
  }

  const isLight = () => document.documentElement.dataset.theme === 'light';
  function start() {
    if (reduced || isLight() || raf) return;
    last = 0;
    raf = requestAnimationFrame(frame);
  }
  function pause() {
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
  }

  resize();
  addEventListener('resize', () => { resize(); if (reduced) drawStatic(); });

  if (reduced) {
    drawStatic();
  } else {
    start();
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : start()));
    // The light theme hides the canvas; stop animating to save CPU, resume on dark.
    document.addEventListener('themechange', () => (isLight() ? pause() : start()));
  }
</script>
