---
// Projects now live as a section on the homepage (see #projects in index.astro).
// This route is kept only to redirect any old/bookmarked /projects links there.
const target = '/#projects';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="/" />
    <meta name="robots" content="noindex" />
    <title>Projects | Atilla Saadat</title>
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>Projects</a>…</p>
  </body>
</html>
