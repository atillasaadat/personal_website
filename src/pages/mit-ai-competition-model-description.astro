---
import Base from '../layouts/Base.astro';
const pdf = '/files/MIT_ARCLab_STORM_AI_Model_Description.pdf';
---
<Base
  title="MIT STORM-AI Model Description | Atilla Saadat"
  description="Model description paper for the MIT ARCLab STORM-AI competition: real-time thermospheric density forecasting with a BiGRU-attention network."
>
  <section class="container section">
    <div class="section-head">
      <p class="kicker">// PUBLICATION</p>
      <h2>MIT STORM-AI Competition: Model Description</h2>
      <p class="actions">
        <a class="btn" href={pdf} download>Download PDF ↓</a>
        <a class="btn" href="/post/mit-storm-ai-challenge">Read the project post →</a>
      </p>
    </div>
    <div class="viewer hud-card">
      <iframe src={pdf} title="MIT STORM-AI Model Description"></iframe>
    </div>
  </section>
</Base>

<style>
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-0);
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .viewer { overflow: hidden; height: min(1200px, 140vh); }
  .viewer iframe { width: 100%; height: 100%; border: 0; display: block; }
  @media (max-width: 720px) { .viewer { height: 70vh; } }
</style>
