---
import Base from '../layouts/Base.astro';

const gallery = [
  { src: '/media/about-me/droid-cleanroom.jpg', caption: "With Turion Space's Droid satellite in the cleanroom" },
  { src: '/media/about-me/emt.jpg', caption: 'On shift as a Nationally Registered EMT' },
  { src: '/media/about-me/rescue-diver.jpg', caption: 'PADI Rescue Diver, Laguna Beach, CA' },
  { src: '/media/about-me/smallsat-award.jpg', caption: '1st place, Frank J. Redd Student Competition, SmallSat 2022' },
  { src: '/media/about-me/sspi-award.jpg', caption: 'SSPI 20 Under 35 award night' },
  { src: '/media/about-me/amos-poster.jpg', caption: 'Presenting at the AMOS Conference, Maui' },
  { src: '/media/about-me/winsat-podium.jpg', caption: 'Presenting WinSAT, the CubeSat team I founded' },
  { src: '/media/about-me/winsat-soldering.jpg', caption: 'SMT soldering WinSAT flight avionics' },
  { src: '/media/about-me/uoft-grad.jpg', caption: 'M.A.Sc. graduation, University of Toronto' },
  { src: '/media/about-me/jpl.jpg', caption: 'At NASA JPL for the F Prime flight-software workshop' },
  { src: '/media/about-me/nvidia.jpg', caption: 'NVIDIA, functional-safety engineering internship' },
  { src: '/media/about-me/snowboarding.jpg', caption: 'Snowboarding' },
  { src: '/media/about-me/santa-monica-10k.jpg', caption: 'Santa Monica Classic 10K' },
];

const skills = [
  { group: 'Languages', items: ['Python', 'MATLAB / Simulink', 'C / C++', 'Java', 'JavaScript', 'PHP', 'HTML / CSS', 'NASA JPL F Prime'] },
  { group: 'GNC & Astrodynamics', items: ['AGI STK', 'FreeFlyer', 'GMAT', 'Basilisk', 'OpenC3 COSMOS'] },
  { group: 'ML & Scientific Computing', items: ['PyTorch', 'TensorFlow', 'Keras', 'scikit-learn', 'OpenCV', 'NumPy', 'SciPy', 'pandas', 'Matplotlib', 'Plotly'] },
  { group: 'CAD & EDA', items: ['Siemens NX (Space Systems Thermal)', 'SolidWorks', 'SolidEdge', 'Catia V5', 'KiCad', 'Altium'] },
  { group: 'Developer & Cloud', items: ['Linux', 'Git', 'Bash', 'Docker', 'PyTest', 'AWS', 'Google Cloud', 'PostgreSQL', 'MongoDB', 'LaTeX'] },
  { group: 'Fabrication & Lab', items: ['SMT soldering', '3D printing', 'MIG / TIG / Stick welding', 'Wire harnessing', 'Oscilloscopes & multimeters', 'ESD compliance', 'Raspberry Pi / Arduino'] },
];

const timeline = [
  { type: 'work', period: 'Nov 2025 - Present', role: 'Spacecraft GNC Engineer II', org: 'Varda Space Industries', place: 'Los Angeles, CA' },
  { type: 'edu', period: 'Jan 2025 - Present', role: 'M.S. Computer Science (Artificial Intelligence)', org: 'Georgia Institute of Technology', place: 'Atlanta, GA' },
  { type: 'work', period: 'Oct 2022 - Nov 2025', role: 'Spacecraft GNC Engineer', org: 'Turion Space Corp.', place: 'Irvine, CA' },
  { type: 'work', period: 'May 2022 - Sep 2022', role: 'Hardware Functional Safety Engineering Intern', org: 'NVIDIA Corp.', place: 'Santa Clara, CA' },
  { type: 'edu', period: 'Sep 2020 - Aug 2022', role: 'M.A.Sc. Aerospace Science & Engineering', org: 'University of Toronto (UTIAS Space Flight Laboratory)', place: 'Toronto, ON' },
  { type: 'work', period: '2018 - 2020', role: 'Founder, President & Lead Space Systems Engineer', org: 'WinSAT, University of Windsor Space & Aeronautics Team', place: 'Windsor, ON' },
  { type: 'work', period: '2017 - 2020', role: 'Robotic Controls Engineering Intern (I & II)', org: 'Mujin Inc.', place: 'Tokyo, Japan' },
  { type: 'work', period: 'May 2016 - Sep 2016', role: 'Space Systems Engineering Intern (Lunar Exploration)', org: 'Canadensys Aerospace Corp.', place: 'Toronto, ON' },
  { type: 'edu', period: 'Sep 2015 - Aug 2020', role: 'B.A.Sc. Mechanical Engineering (Aerospace Option)', org: 'University of Windsor', place: 'Windsor, ON' },
];

const certs = [
  'NASA JPL F Prime Workshop, Advanced & Intro (2026)',
  'Nationally Registered EMT, NREMT (2025)',
  'PADI Rescue Diver with Emergency First Response (2024)',
  'PADI Advanced Open Water & Enriched Air Nitrox Diver (2024)',
  'Basic Life Support, CPR & AED, American Heart Association (2024)',
  'NOLS Wilderness Medicine, First Aid / Epinephrine (2024)',
  'Amateur Radio Operator, Canada, Callsign VA3UWS (2019)',
];

const affiliations = [
  'Aerospace Education Officer (2d Lt), Civil Air Patrol, Squadron 232 (2024 to present)',
  'Programs Chair, AIAA Orange County Section (2024 to present)',
];
---
<Base
  title="About | Atilla Saadat"
  description="About Atilla Saadat: spacecraft GNC engineer, founder of WinSAT, Nationally Registered EMT, and PADI Rescue Diver. Background, skills, experience, and life outside the lab."
>
  <section class="container section">
    <div class="section-head">
      <p class="kicker">// ABOUT</p>
      <h2>About Me</h2>
    </div>

    <div class="bio prose">
      <p>
        I am a spacecraft guidance, navigation, and control (GNC) engineer based in Los Angeles.
        Today I work on reentry-vehicle GNC at <a href="https://www.varda.com" target="_blank" rel="noopener">Varda Space Industries</a>,
        leading trajectory design, Monte Carlo analysis, and on-orbit operations, while pursuing an
        M.S. in Computer Science (AI focus) at Georgia Tech.
      </p>
      <p>
        My path into space started hands-on. As an undergraduate at the University of Windsor I
        founded <strong>WinSAT</strong>, the university's first space and aeronautics team, and led
        20+ students to a 1st place finish in the Canadian Satellite Design Challenge with a 3U
        CubeSat. That pulled me deeper into spacecraft systems: a graduate research fellowship at the
        University of Toronto's Space Flight Laboratory, ADCS work across the HawkEye 360
        constellation, and a 1st place paper at the Small Satellite Conference. Along the way I built
        robotics dynamics-identification software at Mujin in Tokyo (with two granted patents) and
        automotive functional-safety tooling at NVIDIA, then spent three years taking Turion Space's
        Droid satellites from concept through launch and on-orbit operations.
      </p>
      <p>
        Outside of engineering, I like being useful in the real world. I am a Nationally Registered
        <strong> Emergency Medical Technician (EMT)</strong> and a PADI <strong>Rescue Diver</strong>
        trained in emergency first response and wilderness medicine. I serve as an Aerospace
        Education Officer with the Civil Air Patrol, teaching rocketry and electronics to cadets, and
        help run speaker programs for the AIAA Orange County section. When I am not on a call or
        underwater, I am usually snowboarding, running, or chasing the next interesting problem.
      </p>
    </div>

    <h3 class="block-head">In Pictures</h3>
    <p class="gallery-hint">Click any photo to view it larger.</p>
    <ul class="photo-grid" id="photo-grid">
      {gallery.map((g, i) => (
        <li>
          <button class="photo" data-index={i} aria-label={g.caption}>
            <img src={g.src} alt={g.caption} loading="lazy" decoding="async" />
            <span class="photo-cap">{g.caption}</span>
          </button>
        </li>
      ))}
    </ul>

    <h3 class="block-head">Skills</h3>
    <div class="skills">
      {skills.map((s) => (
        <div class="skill-group hud-card">
          <h4>{s.group}</h4>
          <ul>
            {s.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <h3 class="block-head">Experience & Education</h3>
    <ol class="timeline">
      {timeline.map((t) => (
        <li class={`tl-item tl-${t.type}`}>
          <span class="tl-period mono">{t.period}</span>
          <div class="tl-body">
            <h4>{t.role}</h4>
            <p class="tl-org">{t.org}<span class="tl-place"> · {t.place}</span></p>
          </div>
        </li>
      ))}
    </ol>

    <div class="creds">
      <div class="cred-col">
        <h3 class="block-head">Certifications</h3>
        <ul class="cred-list">
          {certs.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="cred-col">
        <h3 class="block-head">Affiliations & Service</h3>
        <ul class="cred-list">
          {affiliations.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" hidden>
    <button class="lb-close" aria-label="Close">✕</button>
    <button class="lb-nav lb-prev" aria-label="Previous">‹</button>
    <figure class="lb-figure">
      <img id="lb-img" src="" alt="" />
      <figcaption id="lb-cap"></figcaption>
    </figure>
    <button class="lb-nav lb-next" aria-label="Next">›</button>
  </div>
</Base>

<style>
  .bio { margin-inline: 0; max-width: 70ch; }

  .block-head {
    font-size: 1.3rem;
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .gallery-hint { margin: -0.5rem 0 1.1rem; color: var(--text-2); font-size: 0.85rem; }

  /* Photo grid */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    background: var(--bg-1);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .photo:hover { border-color: var(--accent); transform: translateY(-2px); }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
    transition: transform 0.3s ease;
  }
  .photo:hover img { transform: scale(1.05); }
  .photo-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.7rem 0.55rem;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--text-0);
    text-align: left;
    background: linear-gradient(to top, rgba(5, 8, 15, 0.92), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .photo:hover .photo-cap, .photo:focus-visible .photo-cap { opacity: 1; }

  /* Skills */
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.1rem; }
  .skill-group { padding: 1.1rem 1.25rem; }
  .skill-group h4 {
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .skill-group ul { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .skill-group li {
    font-size: 0.8rem;
    color: var(--text-1);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-1);
  }

  /* Timeline */
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line);
  }
  .tl-item { position: relative; padding: 0 0 1.5rem 2rem; }
  .tl-item::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-0);
    border: 2px solid var(--accent);
  }
  .tl-edu::before { border-color: var(--accent-2); }
  .tl-period {
    display: block;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-2);
    margin-bottom: 0.15rem;
  }
  .tl-body h4 { margin: 0; font-size: 1.02rem; }
  .tl-org { margin: 0.1rem 0 0; color: var(--text-1); font-size: 0.9rem; }
  .tl-place { color: var(--text-2); }

  /* Creds */
  .creds { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .cred-list { margin: 0; padding-left: 1.1rem; }
  .cred-list li { color: var(--text-1); margin-bottom: 0.5rem; font-size: 0.92rem; }
  @media (max-width: 680px) { .creds { grid-template-columns: 1fr; gap: 0; } }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(3, 5, 10, 0.92);
    backdrop-filter: blur(6px);
    padding: 2rem 3.5rem;
  }
  .lightbox[hidden] { display: none; }
  .lb-figure { margin: 0; max-width: 100%; max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  .lb-figure img {
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
  }
  .lb-figure figcaption { color: var(--text-1); font-size: 0.9rem; text-align: center; max-width: 60ch; }
  .lb-close, .lb-nav {
    position: absolute;
    background: rgba(16, 26, 46, 0.7);
    border: 1px solid var(--line-strong);
    color: var(--text-0);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .lb-close:hover, .lb-nav:hover { border-color: var(--accent); color: var(--accent); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 0.6rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 0.6rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 560px) {
    .lightbox { padding: 1rem; }
    .lb-prev { left: 0.4rem; }
    .lb-next { right: 0.4rem; }
  }
</style>

<script>
  function initAboutGallery() {
    const grid = document.getElementById('photo-grid');
    const lb = document.getElementById('lightbox');
    if (!grid || !lb) return;

    const img = document.getElementById('lb-img') as HTMLImageElement;
    const cap = document.getElementById('lb-cap') as HTMLElement;
    const buttons = Array.from(grid.querySelectorAll<HTMLButtonElement>('.photo'));
    const items = buttons.map((b) => {
      const im = b.querySelector('img') as HTMLImageElement;
      return { src: im.getAttribute('src') || '', cap: im.getAttribute('alt') || '' };
    });
    let current = 0;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      img.src = items[current].src;
      img.alt = items[current].cap;
      cap.textContent = items[current].cap;
    };
    const open = (i: number) => { show(i); lb.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; };
    const close = () => { lb.setAttribute('hidden', ''); document.body.style.overflow = ''; };

    buttons.forEach((b, i) => b.addEventListener('click', () => open(i)));
    lb.querySelector('.lb-close')!.addEventListener('click', close);
    lb.querySelector('.lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
    lb.querySelector('.lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

    // One global key handler, re-pointed each page load.
    (window as any).__aboutKey && document.removeEventListener('keydown', (window as any).__aboutKey);
    const onKey = (e: KeyboardEvent) => {
      if (lb.hasAttribute('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    };
    (window as any).__aboutKey = onKey;
    document.addEventListener('keydown', onKey);
  }
  document.addEventListener('astro:page-load', initAboutGallery);
</script>
