---
import Base from '../layouts/Base.astro';
import AutoGallery from '../components/AutoGallery.astro';

const gallery = [
  { src: '/media/about-me/droid-cleanroom.jpg', caption: "With Turion Space's Droid satellite in the cleanroom" },
  { src: '/media/about-me/iac-presenting.jpg', caption: 'Presenting at the International Astronautical Congress, Paris' },
  { src: '/media/about-me/amos-poster.jpg', caption: 'Presenting at the AMOS Conference, Maui' },
  { src: '/media/about-me/smallsat-award.jpg', caption: '1st place, Frank J. Redd Student Competition, SmallSat 2022' },
  { src: '/media/about-me/sspi-award.jpg', caption: 'SSPI 20 Under 35 award night' },
  { src: '/media/about-me/jpl.jpg', caption: 'At NASA JPL for the F Prime flight-software workshop' },
  { src: '/media/about-me/winsat-podium.jpg', caption: 'Presenting WinSAT, the CubeSat team I founded' },
  { src: '/media/about-me/icasse-presentation.jpg', caption: 'Presenting reaction-wheel fault isolation at ICASSE' },
  { src: '/media/about-me/winsat-soldering.jpg', caption: 'SMT soldering WinSAT flight avionics' },
  { src: '/media/about-me/uoft-grad.jpg', caption: 'M.A.Sc. graduation, University of Toronto' },
  { src: '/media/about-me/nvidia.jpg', caption: 'NVIDIA, functional-safety engineering internship' },
  { src: '/media/about-me/emt.jpg', caption: 'On shift as a Nationally Registered EMT' },
  { src: '/media/about-me/rescue-diver.jpg', caption: 'PADI Rescue Diver, Laguna Beach, CA' },
  { src: '/media/about-me/snowboarding.jpg', caption: 'Snowboarding' },
  { src: '/media/about-me/santa-monica-10k.jpg', caption: 'Santa Monica Classic 10K' },
];

const skills = [
  { group: 'Languages', items: ['Python', 'MATLAB / Simulink', 'C / C++', 'Java', 'JavaScript', 'PHP', 'HTML / CSS', 'NASA JPL F Prime'] },
  { group: 'GNC & Astrodynamics', items: ['AGI STK', 'FreeFlyer', 'GMAT', 'Basilisk', 'OpenC3 COSMOS'] },
  { group: 'ML & Scientific Computing', items: ['PyTorch', 'TensorFlow', 'Keras', 'scikit-learn', 'OpenCV', 'NumPy', 'SciPy', 'pandas', 'Matplotlib', 'Plotly'] },
  { group: 'CAD & EDA', items: ['Siemens NX (Space Systems Thermal)', 'SolidWorks', 'SolidEdge', 'Catia V5', 'KiCad', 'Altium'] },
  { group: 'Developer & Cloud', items: ['Linux', 'Git', 'Bash', 'Docker', 'PyTest', 'AWS', 'Google Cloud', 'PostgreSQL', 'MongoDB', 'LaTeX'] },
  { group: 'Fabrication & Lab', items: ['SMT soldering', '3D printing', 'MIG / TIG / Stick welding', 'Wire harnessing', 'Oscilloscopes & multimeters', 'ESD compliance', 'Raspberry Pi / Arduino'] },
];

// Order mirrors the CV: a reverse-chronological Experience section then an
// Education section. The two Mujin internships (II and I) are kept as separate
// roles, as on the CV.
// Each entry shows an org logo tile. Drop an official logo into
// public/media/logos/ and set `logo` to its path (e.g. '/media/logos/varda.svg')
// to replace the monogram fallback in `short`.
const experience = [
  { period: 'Nov 2025 - Present', role: 'Spacecraft GNC Engineer II', org: 'Varda Space Industries', url: 'https://www.varda.com', place: 'Los Angeles, CA', short: 'V', logo: '' },
  { period: 'Oct 2022 - Nov 2025', role: 'Spacecraft GNC Engineer', org: 'Turion Space Corp.', url: 'https://www.turionspace.com', place: 'Irvine, CA', short: 'TS', logo: '' },
  { period: 'May 2022 - Sep 2022', role: 'Hardware Functional Safety Engineering Intern', org: 'NVIDIA Corp.', url: 'https://www.nvidia.com', place: 'Santa Clara, CA', short: 'N', logo: '' },
  { period: 'Sep 2019 - Jan 2020', role: 'Robotic Controls Engineering Intern II', org: 'Mujin Inc.', url: 'https://mujin-corp.com/', place: 'Tokyo, Japan', short: 'M', logo: '' },
  { period: '2018 - 2020', role: 'Founder, President & Lead Space Systems Engineer', org: 'WinSAT, University of Windsor', url: 'https://www.uwindsor.ca', place: 'Windsor, ON', short: 'W', logo: '' },
  { period: 'May 2017 - May 2018', role: 'Robotic Controls Engineering Intern I', org: 'Mujin Inc.', url: 'https://mujin-corp.com/', place: 'Tokyo, Japan', short: 'M', logo: '' },
  { period: 'May 2016 - Sep 2016', role: 'Space Systems Engineering Intern (Lunar Exploration)', org: 'Canadensys Aerospace Corp.', url: 'https://www.canadensys.com', place: 'Toronto, ON', short: 'C', logo: '' },
];
const education = [
  { period: 'Jan 2025 - Present', role: 'M.S. Computer Science (Artificial Intelligence)', org: 'Georgia Institute of Technology', url: 'https://www.gatech.edu', place: 'Atlanta, GA', short: 'GT', logo: '' },
  { period: 'Sep 2020 - Aug 2022', role: 'M.A.Sc. Aerospace Science & Engineering', org: 'University of Toronto, UTIAS Space Flight Laboratory', url: 'https://sflmissions.com', place: 'Toronto, ON', short: 'UT', logo: '' },
  { period: 'Sep 2015 - Aug 2020', role: 'B.A.Sc. Mechanical Engineering (Aerospace Option)', org: 'University of Windsor', url: 'https://www.uwindsor.ca', place: 'Windsor, ON', short: 'UW', logo: '' },
];

const certs = [
  'NASA JPL F Prime Workshop, Advanced & Intro (2026)',
  'Nationally Registered EMT, NREMT (2025)',
  'PADI Rescue Diver with Emergency First Response (2024)',
  'PADI Advanced Open Water & Enriched Air Nitrox Diver (2024)',
  'Basic Life Support, CPR & AED, American Heart Association (2024)',
  'NOLS Wilderness Medicine, First Aid / Epinephrine (2024)',
  'Amateur Radio Operator, Canada, Callsign VA3UWS (2019)',
];

const affiliations = [
  'Aerospace Education Officer (2d Lt), Civil Air Patrol, Squadron 232 (2024 to present)',
  'Programs Chair, AIAA Orange County Section (2024 to present)',
];
---
<Base
  title="About | Atilla Saadat"
  description="About Atilla Saadat: spacecraft GNC engineer, founder of WinSAT, Nationally Registered EMT, and PADI Rescue Diver. Background, skills, experience, and life outside the lab."
>
  <section class="container section">
    <div class="section-head">
      <p class="kicker">// ABOUT</p>
      <h2>About Me</h2>
    </div>

    <div class="about-split">
      <div class="bio">
        <p>
          I'm a spacecraft GNC engineer in Los Angeles. At
          <a href="https://www.varda.com" target="_blank" rel="noopener">Varda Space Industries</a>
          I work on guidance, navigation, and control for our reentry vehicles, which means everything
          from designing trajectories and running the Monte Carlo analysis to flying the missions once
          they reach orbit. I'm also working toward an M.S. in Computer Science at
          <a href="https://www.gatech.edu" target="_blank" rel="noopener">Georgia Tech</a>, with a
          focus on AI.
        </p>
        <p>
          I got into this by building hardware. As an undergrad at the
          <a href="https://www.uwindsor.ca" target="_blank" rel="noopener">University of Windsor</a> I
          started <a href="/post/winsat-3u-leo-cube-satellite">WinSAT</a>, the school's first satellite team, and we took a 3U CubeSat to first place in
          the Canadian Satellite Design Challenge. That led to graduate research at the
          <a href="https://sflmissions.com" target="_blank" rel="noopener">University of Toronto's Space Flight Laboratory</a>,
          where I worked on attitude control for the HawkEye 360 satellites and won the student paper
          competition at the Small Satellite Conference. Earlier I'd written robotics dynamics software
          at <a href="https://mujin-corp.com/" target="_blank" rel="noopener">Mujin</a> in Tokyo, which
          turned into two patents, and spent a summer on automotive functional safety at
          <a href="https://www.nvidia.com" target="_blank" rel="noopener">NVIDIA</a>. Most recently I was
          at <a href="https://www.turionspace.com" target="_blank" rel="noopener">Turion Space</a> for
          three years, where I took the Droid satellites from a concept all the way to operating them in
          orbit.
        </p>
        <p>
          Most of my time away from work goes to emergency response and the water. I'm a Nationally
          Registered EMT and a PADI Rescue Diver, with training in wilderness and emergency
          first-response medicine. I also serve as an Aerospace Education Officer with the
          <a href="https://sq232.cap.gov" target="_blank" rel="noopener">Civil Air Patrol</a>,
          teaching cadets rocketry and electronics, and I run the speaker program for the
          <a href="https://www.aiaa.org" target="_blank" rel="noopener">AIAA</a> Orange County section.
          The rest of the time, I'm usually snowboarding or out for a run.
        </p>
      </div>
      <div class="about-gallery">
        <AutoGallery images={gallery} ratio="4 / 5" label="Photos of Atilla Saadat" />
      </div>
    </div>

    <h3 class="block-head">Skills</h3>
    <div class="skills">
      {skills.map((s) => (
        <div class="skill-group hud-card">
          <h4>{s.group}</h4>
          <ul>
            {s.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <h3 class="block-head">Experience</h3>
    <ol class="xp">
      {experience.map((t) => (
        <li class="xp-item">
          <span class="xp-logo" aria-hidden="true">
            {t.logo ? <img src={t.logo} alt="" loading="lazy" decoding="async" /> : <span class="xp-mono">{t.short}</span>}
          </span>
          <div class="xp-body">
            <span class="xp-period mono">{t.period}</span>
            <h4 class="xp-role">{t.role}</h4>
            <p class="xp-org"><a href={t.url} target="_blank" rel="noopener">{t.org}</a><span class="xp-place"> · {t.place}</span></p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="block-head">Education</h3>
    <ol class="xp">
      {education.map((t) => (
        <li class="xp-item">
          <span class="xp-logo" aria-hidden="true">
            {t.logo ? <img src={t.logo} alt="" loading="lazy" decoding="async" /> : <span class="xp-mono">{t.short}</span>}
          </span>
          <div class="xp-body">
            <span class="xp-period mono">{t.period}</span>
            <h4 class="xp-role">{t.role}</h4>
            <p class="xp-org"><a href={t.url} target="_blank" rel="noopener">{t.org}</a><span class="xp-place"> · {t.place}</span></p>
          </div>
        </li>
      ))}
    </ol>

    <div class="creds">
      <div class="cred-col">
        <h3 class="block-head">Certifications</h3>
        <ul class="cred-list">
          {certs.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="cred-col">
        <h3 class="block-head">Affiliations & Service</h3>
        <ul class="cred-list">
          {affiliations.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-split {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .bio p {
    color: var(--text-1);
    max-width: 65ch;
    margin: 0 0 1.15rem;
    text-wrap: pretty;
  }
  .bio p:first-child { margin-top: 0; }
  .bio strong { color: var(--text-0); }
  .about-gallery { position: sticky; top: calc(var(--header-h) + 1.25rem); }

  @media (max-width: 820px) {
    .about-split { grid-template-columns: minmax(0, 1fr); }
    .about-gallery { position: static; max-width: 460px; margin-inline: auto; width: 100%; }
  }

  .block-head {
    font-size: 1.3rem;
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  /* Skills */
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.1rem; }
  .skill-group { padding: 1.1rem 1.25rem; }
  .skill-group h4 {
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .skill-group ul { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .skill-group li {
    font-size: 0.8rem;
    color: var(--text-1);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-1);
  }

  /* Experience / Education, an aligned logo-tile list */
  .xp { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.15rem; }
  .xp-item { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 1rem; align-items: start; }
  .xp-logo {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 11px;
    border: 1px solid var(--line);
    /* Light plate so dark/colored logos read in either theme (matches Awards). */
    background: #eef1f7;
  }
  .xp-logo img { width: 100%; height: 100%; object-fit: contain; padding: 7px; margin: 0; border: 0; border-radius: 0; }
  .xp-mono {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    color: #0b1322;
  }
  .xp-period {
    display: block;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--text-2);
    margin-bottom: 0.1rem;
  }
  .xp-role { margin: 0; font-size: 1.02rem; }
  .xp-org { margin: 0.12rem 0 0; color: var(--text-1); font-size: 0.9rem; }
  .xp-org a { color: var(--text-1); }
  .xp-org a:hover { color: var(--accent); }
  .xp-place { color: var(--text-2); }

  /* Creds */
  .creds { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .cred-list { margin: 0; padding-left: 1.1rem; }
  .cred-list li { color: var(--text-1); margin-bottom: 0.5rem; font-size: 0.92rem; }
  @media (max-width: 680px) { .creds { grid-template-columns: 1fr; gap: 0; } }
</style>
