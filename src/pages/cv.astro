---
import Base from '../layouts/Base.astro';
const cvPath = '/files/Atilla_Saadat_CV.pdf';
---
<Base title="CV | Atilla Saadat" description="Curriculum vitae of Atilla Saadat, Spacecraft GNC Engineer.">
  <section class="container section">
    <div class="section-head">
      <p class="kicker">// CURRICULUM VITAE</p>
      <h2>CV</h2>
      <p class="actions">
        <a class="btn" href={cvPath} download>Download PDF ↓</a>
        <a class="btn" href={cvPath} target="_blank" rel="noopener">Open in new tab ↗</a>
      </p>
    </div>
    <div class="viewer hud-card">
      <iframe src={cvPath} title="Atilla Saadat CV"></iframe>
      <p class="fallback">
        Your browser can't display the embedded PDF.
        <a href={cvPath}>Download it instead</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-0);
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .viewer {
    overflow: hidden;
    height: min(1200px, 140vh);
  }
  .viewer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .fallback { display: none; padding: 1rem 1.25rem; }
  @media (max-width: 720px) {
    /* mobile browsers often refuse inline PDF iframes, keep it short and rely on buttons */
    .viewer { height: 70vh; }
  }
</style>
