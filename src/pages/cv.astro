---
import Base from '../layouts/Base.astro';
const cvPath = '/files/Atilla_Saadat_CV.pdf';
// Self-hosted Mozilla PDF.js viewer (see public/pdfjs/), the same engine
// behind Firefox's built-in PDF viewer: thumbnails, outline, find, zoom,
// print, and download, all rendered from the file already on this origin.
// #pagemode=none is required: PDF.js opens its outline panel on every load,
// and on a phone that panel is an overlay, not a column, so it covers half
// the CV. The reader can still open it from the toolbar.
const viewerSrc = `/pdfjs/web/viewer.html?file=${encodeURIComponent(cvPath)}#pagemode=none`;
---
<Base title="CV | Atilla Saadat" description="Curriculum vitae of Atilla Saadat, Spacecraft GNC Engineer.">
  <section class="container section">
    <div class="section-head">
      <p class="kicker">// CURRICULUM VITAE</p>
      <h1>CV</h1>
      <p class="actions">
        <a class="btn" href={cvPath} download>Download PDF ↓</a>
        <a class="btn" href={cvPath} target="_blank" rel="noopener">Open in new tab ↗</a>
      </p>
    </div>
    <div class="viewer hud-card">
      <iframe src={viewerSrc} title="Atilla Saadat CV"></iframe>
    </div>
  </section>
</Base>

<style>
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-0);
  }
  .btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .viewer {
    overflow: hidden;
    height: min(1200px, 140vh);
  }
  .viewer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (max-width: 720px) {
    .viewer { height: 80vh; }
  }
</style>
