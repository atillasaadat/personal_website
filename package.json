    "astro": "^7.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "linkinator": "^8.0.4",
    "playwright": "^1.60.0",
    "satori": "^0.26.0"
